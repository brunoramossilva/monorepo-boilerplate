{
  "name": "monorepo-boilerplate",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=mobile --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "docker:up": "docker-compose up -d postgres server adminer",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f server",
    "docker:rebuild": "docker-compose up -d --build server",
    "db:push": "pnpm --filter server db:push",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:studio": "pnpm --filter server db:studio",
    "db:generate": "pnpm --filter server db:generate"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  }
}
