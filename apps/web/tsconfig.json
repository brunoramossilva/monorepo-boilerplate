{
    "extends": "../../packages/config/typescript/base.json",
    "compilerOptions": {
        "plugins": [
            {
                "name": "next"
            }
        ],
        "moduleResolution": "bundler",
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@repo/types": [
                "../../packages/types/src"
            ],
            "@repo/utils": [
                "../../packages/utils/src"
            ]
        },
        "jsx": "preserve"
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}